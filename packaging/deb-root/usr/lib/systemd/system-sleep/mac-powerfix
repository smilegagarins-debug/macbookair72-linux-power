#!/bin/sh
# /usr/lib/systemd/system-sleep/mac-powerfix - re-apply after resume (synchronously).
# NOTE: systemd 259 (Ubuntu 26.04) only runs hooks from /usr/lib/systemd/system-sleep/, not /etc/.
case "$1" in post) sleep 2; systemctl is-active -q mac-powerfix.service && /usr/sbin/mac-powerfix apply 2>&1 | logger -t mac-powerfix ;; esac
exit 0
